{
  "name": "usage-aware-multiai-orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "myorch": "./dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "node scripts/prepare.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "verify:claude-files": "node --import tsx src/cli.ts verify-claude-files",
    "verify:claude-runtime": "node --import tsx src/cli.ts verify-claude-runtime",
    "verify:scenarios": "node scripts/run-scenarios.mjs",
    "verify:links": "node scripts/check-doc-links.mjs",
    "verify:all": "npm run verify && npm run verify:claude-runtime && npm run verify:scenarios && npm run verify:links",
    "verify": "npm test && npm run build && npm run verify:claude-files"
  },
  "files": [
    "dist/src/",
    ".claude/commands/",
    ".claude/hooks/",
    ".claude/rules/",
    ".claude/settings.json",
    ".claude/statusline.sh",
    ".claude/myorch.md",
    ".codex/",
    "scripts/",
    "README.md",
    "README.ko.md",
    "docs/",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CLAUDE.md"
  ],
  "devDependencies": {
    "@types/node": "^22.15.18",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
